# End of https://www.toptal.com/developers/gitignore/api/flutter,androidstudio,windows,linux,macos,visualstudiocode

# Project specific ignores
**/android-sdk/  # Ignore the Android SDK in home directory
**/android/local.properties  # Contains local machine paths
**/ios/Pods/  # CocoaPods dependencies
**/ios/.symlinks/  # Flutter plugin symlinks
**/ios/Flutter/App.framework/  # Flutter engine framework
**/ios/Flutter/Flutter.framework/  # Flutter framework
**/ios/Flutter/Flutter.podspec  # Flutter podspec
**/ios/Flutter/Generated.xcconfig  # Generated config file
**/ios/Flutter/flutter_export_environment.sh  # Environment script
**/ios/Runner/GeneratedPluginRegistrant.*  # Generated plugin registrant
**/macos/Flutter/GeneratedPluginRegistrant.swift  # macOS generated plugin registrant
**/web/**/.dart_tool/  # Web-specific Dart tool
**/web/**/build/  # Web build output

# ML Kit and other large model files (if any)
**/models/*.tflite
**/models/*.bin
**/assets/ml/  # If you store ML models in assets

# Firebase config files (if used)
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/lib/firebase_options.dart

# Environment config files (for API keys, etc.)
.env
.env.*
!env.example

# IDE specific files (in addition to above)
.idea/
.vscode/
*.swp
*.swo
*~

